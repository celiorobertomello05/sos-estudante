# Copie para ".env" (que NÃO vai para o Git) e preencha com os dados do seu projeto.
# Supabase → Project Settings → API.
# Use somente a chave "anon / public". NUNCA coloque a service_role aqui:
# tudo que começa com EXPO_PUBLIC_ é embutido no aplicativo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# "false" desliga o modo demonstração no build de produção.
EXPO_PUBLIC_ENABLE_DEMO_MODE=false
EXPO_PUBLIC_SUPPORT_EMAIL=suporte@example.com
